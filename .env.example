# ============================================================
# Prince Portfolio AI Chatbot — Environment Configuration Reference
# ============================================================
# This file documents all environment variables used across local development,
# Vercel Serverless Functions (/api/chat), and GitHub Actions CI/CD workflows.
# NEVER commit real API keys or secrets to version control.
# ============================================================

# ------------------------------------------------------------
# 1. GOOGLE GEMINI AI (PRIMARY LLM & VECTOR EMBEDDINGS)
# ------------------------------------------------------------
# REQUIRED in Vercel & GitHub Actions
# Google GenAI API key for vector embeddings and chat generation.
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL in Vercel (Defaults to "gemini-3.5-flash-lite")
# Primary Gemini model used for text generation.
GEMINI_LLM_MODEL=gemini-3.5-flash-lite

# OPTIONAL (Defaults to "gemini-embedding-2")
# Gemini embedding model used for vector retrieval (768 dimensions).
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_MODEL=gemini-embedding-2

# OPTIONAL (Defaults to 768)
# Vector embedding dimension size. Must match Supabase vector(768) column.
EMBEDDING_DIMENSION=768


# ------------------------------------------------------------
# 2. MISTRAL AI (FALLBACK LLM PROVIDER)
# ------------------------------------------------------------
# OPTIONAL in Vercel & GitHub Actions (Recommended for high-traffic failover)
# API key for Mistral AI fallback provider when Gemini experiences 503/429 outages.
MISTRAL_API_KEY=your_mistral_api_key_here

# OPTIONAL in Vercel (Defaults to "mistral-small-latest")
# Mistral model used during provider failover.
MISTRAL_LLM_MODEL=mistral-small-latest


# ------------------------------------------------------------
# 3. SUPABASE POSTGRESQL + PGVECTOR
# ------------------------------------------------------------
# REQUIRED in Vercel & GitHub Actions
# Supabase project REST API endpoint URL.
SUPABASE_URL=https://your-project-id.supabase.co

# REQUIRED in Vercel & GitHub Actions
# Supabase Service Role Key (service_role secret key).
# DO NOT use the public anon key.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here


# ------------------------------------------------------------
# 4. GITHUB API INTEGRATION (OPTIONAL)
# ------------------------------------------------------------
# OPTIONAL in Vercel
# Personal access token for /api/github endpoint rate-limit extension.
GITHUB_TOKEN=your_github_personal_access_token_here


# ------------------------------------------------------------
# 5. DIAGNOSTICS & DEBUGGING
# ------------------------------------------------------------
# OPTIONAL (Set to "true" for verbose non-leaking diagnostic logging in Vercel)
CHAT_DEBUG=false
